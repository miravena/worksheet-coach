#!/bin/sh
# pre-push: last local gate before anything becomes public.
# BLOCK if a pushed commit message carries a private tracker id. Cite GitHub issues (#N) only.
status=0
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    if git rev-parse --verify --quiet origin/main >/dev/null; then range="origin/main..$local_sha"; else range="$local_sha"; fi
  else range="$remote_sha..$local_sha"; fi
  ids=$(git log --format='%h %B' "$range" 2>/dev/null | grep -inE "off""ice ?#[0-9]+|ticket #[0-9]{4,}|(^|[^0-9A-Za-z&#/])#[0-9]{4,6}([^0-9A-Za-z]|$)" || true)
  if [ -n "$ids" ]; then
    echo "pre-push: BLOCKED: private tracker ids in commit messages (cite GitHub #N only):" >&2
    printf '%s\n' "$ids" | sed 's/^/  /' >&2
    status=1
  fi
done
exit $status
